# Identifiers only. Copy this file to ignored .env and authenticate interactively.
# Do not store passwords, tokens, private-key contents, or connection strings here.

AZURE_SUBSCRIPTION_ID=<subscription-id>
AZURE_TENANT_ID=<tenant-id>
AZURE_LOCATION=westus3

FABRIC_CAPACITY_ID=<fabric-capacity-guid>
FABRIC_CAPACITY_NAME=<existing-capacity-name>
# Used only by infra/fabric/capacity.py for ARM status/resume/suspend.
FABRIC_CAPACITY_RESOURCE_ID=<full-microsoft-fabric-capacity-arm-resource-id>
FABRIC_WORKSPACE_ID=<fabric-workspace-guid>
FABRIC_WORKSPACE_NAME=fabric-snowflake-medallion-poc
FABRIC_SNOWFLAKE_MIRROR_NAME=snowflake_bronze
FABRIC_SNOWFLAKE_CONNECTION_ID=<fabric-snowflake-connection-guid>
FABRIC_SNOWFLAKE_CONNECTION_NAME=fabric-snowflake-medallion-poc-keypair
# Inputs for optional `python -m infra.fabric.vnet_gateway` automation.
FABRIC_VNET_GATEWAY_NAME=fabric-snowflake-medallion-poc-vnet
FABRIC_VNET_SUBSCRIPTION_ID=<azure-subscription-guid>
FABRIC_VNET_RESOURCE_GROUP=<existing-network-resource-group>
FABRIC_VNET_NAME=<existing-virtual-network>
FABRIC_VNET_GATEWAY_SUBNET=<dedicated-delegated-subnet-name>
FABRIC_VNET_GATEWAY_INACTIVITY_MINUTES=30
FABRIC_VNET_GATEWAY_MIN_MEMBERS=1
FABRIC_VNET_GATEWAY_MAX_MEMBERS=1
# Customer default: route through an existing Fabric VNet data gateway.
FABRIC_SNOWFLAKE_CONNECTIVITY_TYPE=VirtualNetworkGateway
FABRIC_SNOWFLAKE_GATEWAY_ID=<fabric-vnet-data-gateway-guid>
# Use privatelink-account-url from SYSTEM$GET_PRIVATELINK_CONFIG().
FABRIC_SNOWFLAKE_SERVER=<private-snowflake-account-hostname>
# Use ignored local files; never paste private-key material into this file.
FABRIC_SNOWFLAKE_USER=<dedicated-snowflake-service-user>
FABRIC_SNOWFLAKE_PRIVATE_KEY_FILE=<path-to-encrypted-pkcs8-pem>
FABRIC_SNOWFLAKE_PRIVATE_KEY_PASSPHRASE_FILE=<path-to-local-passphrase-file>
# For an explicitly approved public-network lab only, use ShareableCloud and
# omit FABRIC_SNOWFLAKE_GATEWAY_ID. The helper can then derive the public host.
FABRIC_ALLOW_SNOWFLAKE_MIRROR_RECREATE=false
FABRIC_SILVER_LAKEHOUSE_NAME=silver_lh
FABRIC_GOLD_LAKEHOUSE_NAME=gold_lh
FABRIC_WAREHOUSE_NAME=gold_wh
# Copy the Warehouse connection string from Fabric for tools/fabric_sql.py.
FABRIC_SQL_ENDPOINT=<fabric-sql-endpoint-hostname>

# The account identifier does not include https:// or snowflakecomputing.com.
SNOWFLAKE_ACCOUNT=<organization-account>
SNOWFLAKE_USER=<interactive-or-service-user>
SNOWFLAKE_AUTHENTICATOR=externalbrowser
SNOWFLAKE_ROLE=FABRIC_POC_LOADER
SNOWFLAKE_SETUP_ROLE=<approved-admin-role-for-initial-setup>
SNOWFLAKE_WAREHOUSE=<existing-approved-warehouse>
SNOWFLAKE_DATABASE=<existing-enterprise-database>
SNOWFLAKE_SCHEMA=<dedicated-poc-schema>
SNOWFLAKE_LOADER_ROLE=FABRIC_POC_LOADER
SNOWFLAKE_MIRROR_ROLE=FABRIC_POC_MIRROR

# For key-pair auth, set these only in the local ignored .env or process environment:
# SNOWFLAKE_AUTHENTICATOR=SNOWFLAKE_JWT
# SNOWFLAKE_PRIVATE_KEY_FILE=<absolute-path-outside-repository>
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE_FILE=<path-to-ignored-local-passphrase-file>
# Alternatively, set SNOWFLAKE_PRIVATE_KEY_PASSPHRASE only in the invoking process.
# Password auth is supported only through an ignored .env or process environment:
# SNOWFLAKE_PASSWORD=<set-in-process-environment>

GITHUB_OWNER=<github-owner>
GITHUB_REPOSITORY=fabric-snowflake-medallion-poc
GITHUB_BRANCH=main
FABRIC_GIT_DIRECTORY=/fabric_git
# Set GITHUB_PAT only in the invoking process. Never persist it in this file.
